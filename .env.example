# Gemini API key (https://aistudio.google.com/apikey). Server-side only; never exposed to the browser.
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Tried in order when a model is out of quota / down. Free-tier quotas are per model, so each one adds capacity.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-3-flash-preview,gemini-3.5-flash,gemini-3.6-flash
# Identical AI requests are cached on disk in .cache/gemini (instant, no quota). Set to off to disable.
# GEMINI_CACHE=on

# --- CoStar data kit (listings + market data are built from it by `npm run costar`) ---
COSTAR_DUMP_PATH=../CoStar/backend/data/costar-hackathon-kit
# NEXT_PUBLIC_DEMO_CITY=Houston   # Houston | Los Angeles

# --- Matterport / Vexcel (server side only; 3D tours embed via the public Showcase player) ---
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
NEXT_PUBLIC_MATTERPORT_SDK_KEY=
VEXCEL_API_KEY=

# --- Exterior 3D (drone Gaussian splats; `npm run exteriors` links them to listings) ---
# models_index.csv from the Matterport quickstart (one row per model, `splat = yes` for the 232 with an exterior)
MATTERPORT_INDEX_PATH=../CoStar/backend/data/models_index.csv
# HACKATHON_SITE=https://beta-app.matterport.com/2026-princeton-hackathon
